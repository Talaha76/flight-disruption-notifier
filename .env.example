# Copy to .env (not committed) or set in your PowerShell session, e.g.  $env:CDK_DEFAULT_REGION="us-east-2"
# All are optional; CDK context flags (-c key=value) take precedence.

# AWS target (normally taken from your AWS CLI profile)
AWS_PROFILE=default
CDK_DEFAULT_REGION=us-east-2

# Stack options (equivalent to -c notificationEmail=... etc.)
FDN_NOTIFICATION_EMAIL=           # receives channel=email notifications (confirm the SNS email)
FDN_ALARM_EMAIL=                  # receives CloudWatch alarm emails
FDN_BILLING_MODE=PROVISIONED      # PROVISIONED (free tier) | PAY_PER_REQUEST (spike tests only)
FDN_FEED_SCHEDULE_ENABLED=false   # true = run the legacy XML feed simulator every minute
FDN_PROCESSOR_MAX_CONCURRENCY=2   # SQS event-source max concurrency (2-1000)
FDN_STACK_NAME=FlightDisruptionNotifier
